# Nexisco Network — Deployment Credentials TEMPLATE
# Copy this file to .deploy/.env and fill in real values.
# .deploy/.env is gitignored — never commit credentials.

# ── SSH / SFTP ────────────────────────────────────────────────
SSH_HOST=nexisconetwork.ca
SSH_PORT=22
SSH_USER=your_cpanel_username
SSH_KEY=.deploy/id_godaddy

# ── Remote paths ──────────────────────────────────────────────
REMOTE_DOCROOT=/home/your_cpanel_username/public_html/nexisconetwork.ca
REMOTE_HOME=/home/your_cpanel_username

# ── cPanel ────────────────────────────────────────────────────
CPANEL_URL=https://nexisconetwork.ca:2083
CPANEL_USER=your_cpanel_username
CPANEL_PASS=your_cpanel_password

# ── MariaDB ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexisco
DB_USER=db_user
DB_PASS=db_password

# ── Admin panel ───────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=admin_password

# ── SMTP ──────────────────────────────────────────────────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=noreply@nexisconetwork.ca
SMTP_PASS=create_in_cpanel_email_accounts

# ── Domain ────────────────────────────────────────────────────
SITE_URL=https://nexisconetwork.ca
PROD_DOMAIN=nexisconetwork.ca
