# Nexisco Network .gitignore

# Dependencies
node_modules/

# Compiled CSS (regenerated by npm run build)
public_html/assets/css/app.css

# Live credentials — NEVER commit
public_html/config/config.php

# Deployment secrets — NEVER commit
.env
.env.*
!.env.example
.deploy/
deploy-secrets/

# Local server state
.server.pid
.server.log

# Working notes / local dev artifacts
STARTUP_PROGRESS.md
PASTE_THIS_PROMPT.md
.test_alpine*.mjs

# Rate limiter temp files
/tmp/nxn_rl/

# OS
.DS_Store
Thumbs.db
*.swp

# Editor
.vscode/
.idea/
*.code-workspace

# Build artifacts
*.min.css.map
*.min.js.map

# Logs
*.log
error_log

# PHPMailer real files (install manually from GitHub — stubs only in repo)
# Uncomment below if you want to gitignore the real PHPMailer files
# public_html/lib/PHPMailer/

# Uploaded assets (manage separately, not in git)
# public_html/assets/img/hero/*.webp
# public_html/assets/video/*.mp4
# public_html/assets/video/*.webm

# Duplicate-project export — NOT part of this repo
aegisitsolutions.zip
/aegisitsolutions/

# Local AI tooling / skill caches — not site code
.agents/
.claude/
skills-lock.json

# Loose design screenshots / mockups (not in the asset pipeline)
nexisco-2.png
